{
  "openapi": "3.0.0",
  "info": { "title": "Practice Items API", "version": "1.2.2" },
  "servers": [{ "url": "http://localhost:3001" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Attempt": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "result": { "type": "string", "enum": ["correct", "wrong", "partial"] },
          "user_response": { "type": "string" }
        },
        "required": ["result"]
      },
      "SpacedPractice": {
        "type": "object",
        "properties": {
            "streak": { "type": "integer", "default": 0 },
            "total_attempts": { "type": "integer", "default": 0 },
            "correct_attempts": { "type": "integer", "default": 0 },
            "last_attempt_result": { "type": "string", "enum": ["correct", "wrong", "partial"], "default": "wrong" },
            "priority_score": { "type": "number", "default": 1 },
            "next_due": { 
            "type": ["string", "null"], 
            "format": "date-time" 
            }
        }
      },
      "UserMistake": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "user_input": { "type": "string" },
          "ai_response": { "type": "string" },
          "mistake_type": { "type": "string" },
          "correction": { "type": "string" },
          "description": { "type": "string" },
          "user_id": { "type": "string" },
          "conversation_id": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "attempts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Attempt" },
            "default": []
          },
          "spaced_practice": { "$ref": "#/components/schemas/SpacedPractice" }
        },
        "required": ["_id", "user_input", "mistake_type", "correction", "description", "user_id"]
      },
      "PracticeItemResponse": {
        "type": "object",
        "properties": {
          "mistake": { "$ref": "#/components/schemas/UserMistake" },
          "log_attempt_id": { "type": "string" }
        },
        "required": ["mistake", "log_attempt_id"]
      },
      "AttemptRequest": {
        "type": "object",
        "properties": {
          "result": { "type": "string", "enum": ["correct", "wrong", "partial"] },
          "user_response": { "type": "string" }
        },
        "required": ["result", "user_response"] 
      },
      "AttemptResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "next_due": { "type": "string", "format": "date-time" }
        },
        "required": ["success", "next_due"]
      }
    }
  },
  "paths": {
    "/user-mistakes/item": {
      "get": {
        "operationId": "get_item",
        "summary": "Get next due practice item",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PracticeItemResponse" } } }
          },
          "404": {
            "description": "No items due",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "error": { "type": "string" } } } } }
          }
        }
      }
    },
    "/user-mistakes/{id}/attempts": {
      "post": {
        "operationId": "log_attempt",
        "summary": "Log user attempt and update SRS",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AttemptRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Logged",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AttemptResponse" } } }
          },
          "400": {
            "description": "Invalid result",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "error": { "type": "string" } } } } }
          },
          "404": {
            "description": "Mistake not found",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "error": { "type": "string" } } } } }
          }
        }
      }
    }
  }
}